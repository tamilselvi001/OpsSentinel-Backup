# ─────────────────────────────────────────────────────────────────────────────
# OpsSentinel — repo-root .gitignore (Phase 0 bootstrap)
# Global build rule #4: secrets are NEVER committed. .env stays local only.
# Phase 1 (Task 5.1) may extend this with service-specific entries.
# ─────────────────────────────────────────────────────────────────────────────

# Secrets & local environment — never commit
.env
.env.*
!.env.example
*.pem
*.key
*-key.json
service-account*.json
credentials*.json

# Source spec PDFs are local reference only (drop them in docs/)
docs/*.pdf

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Next.js (frontend)
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Terraform / IaC state (never commit state or vars with secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# Docker / local data volumes
*.log
pgdata/
.docker/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
